# `node scripts/ingest-local.mjs` neu auf.
data/

# Wrangler-Zustand und lokale Secrets. .dev.vars enthaelt im Zweifel Tokens -
# niemals committen.
.wrangler/
.dev.vars
.dev.vars.*

# Editor-/Sitzungszustand
.claude/
.vscode/
.idea/

# Betriebssystem
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
