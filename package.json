{
  "name": "etn-whale-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Top-Holder- und Migrations-Tracker fuer die Electroneum Smart Chain",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create etn-tracker",
    "db:init": "wrangler d1 execute etn-tracker --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute etn-tracker --local --file=./schema.sql",
    "db:migrate": "node scripts/apply-migrations.mjs --remote",
    "db:migrate:local": "node scripts/apply-migrations.mjs",
    "serve": "node scripts/serve-local.mjs",
    "backfill": "node scripts/backfill.mjs",
    "ingest:once": "node scripts/ingest-local.mjs",
    "test": "node scripts/tests.mjs",
    "test:schnell": "node scripts/tests.mjs --schnell"
  },
  "devDependencies": {
    "sharp": "^0.34.5",
    "wrangler": "4.131.0"
  }
}
